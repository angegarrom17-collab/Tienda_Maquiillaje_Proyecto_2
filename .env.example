# Copie este archivo como .env y complete los valores de SU entorno local.
DB_NAME=tienda_belleza_db
DB_USER=tienda_belleza_user
DB_PASSWORD=cambie_esta_clave
DB_HOST=localhost
DB_PORT=3306

# Opcional: clave secreta propia (si no se indica, se usa la de desarrollo)
DJANGO_SECRET_KEY=

# Orígenes del frontend React autorizados por CORS (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
