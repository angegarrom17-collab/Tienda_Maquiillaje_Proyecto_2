# Plantilla de configuración del backend (este archivo SÍ se sube a GitHub).
# Cópielo como .env y complete los valores reales de SU entorno local.
# El archivo .env real NUNCA se sube al repositorio (está en .gitignore).

# Conexión a MySQL (deben coincidir con el script de creación de la base de datos)
DB_NAME=tienda_belleza_db
DB_USER=tienda_belleza_user
DB_PASSWORD=cambie_esta_clave
DB_HOST=localhost
DB_PORT=3306

# Obligatoria: clave secreta de Django (la real va solo en .env).
# Genere una propia con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=coloque_aqui_su_clave

# Orígenes del frontend React autorizados por CORS (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173